<!-- The page carries more than one screen of information, so it splits into
     tabs. Each tab is a link to a path of its own, and the server renders the
     one that the path names: the page reloads itself every 30 seconds, and
     only the URL survives that reload.

     A dot beside a name says that the tab behind it needs attention. Without
     it a tab would hide the fault that the badge in the header reports. -->
<nav class="tabs" aria-label="Sections">
  <% tabs.each do |tab| %>
    <a
      class="tabs__tab"
      href="<%= tab[:path] %>"
      aria-current="<%= tab[:current] ? 'page' : 'false' %>"
    ><%= tab[:label] %><% if tab[:level] %><span class="tabs__dot <%= tab[:level] %>" title="Needs attention"></span><% end %></a>
  <% end %>
</nav>

<%= erb :"_tab_#{current_tab.tr('-', '_')}", layout: false %>
