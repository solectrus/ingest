<!-- The three stages of the data path, in the order the data takes. Both
     stages that carry values report them per minute, so the reader can
     compare what arrives with what leaves. What holds a line back stands in
     the box that holds it: an invalid line never leaves the incoming stage,
     and a line that waits for InfluxDB waits inside Ingest. -->
<section class="flow">
  <article class="flow__node">
    <h2>Incoming <small>(from collectors)</small></h2>
    <p class="metric">
      <span class="metric__value"><%= value_or_dash(incoming_values_rate) { |r| number_to_delimited(rate_number(r)) } %></span>
      <span class="metric__unit">values /min</span>
    </p>

    <dl class="right">
      <dt>Line throughput</dt>
      <dd><%= value_or_dash(incoming_lines_rate) { |r| format_rate(r) } %></dd>

      <dt>Last line</dt>
      <dd class="<%= status_of(:incoming_age) %>"><%= value_or_dash(incoming_age) { |a| format_age(a) } %></dd>

      <dt>Response time <small>(average)</small></dt>
      <dd><%= value_or_dash(response_time) { |t| "#{number_to_delimited(t)} ms" } %></dd>
    </dl>

    <h2>Since start</h2>
    <dl class="right">
      <dt>Values received</dt>
      <dd><%= number_to_delimited(incoming_values) %></dd>

      <dt>Lines received</dt>
      <dd><%= number_to_delimited(incoming_lines) %></dd>

      <dt>Requests</dt>
      <dd><%= number_to_delimited(Stats.counter(:http_requests)) %></dd>

      <dt>Invalid lines <small>(not parsable)</small></dt>
      <dd class="<%= status_of(:skipped_lines) %>"><%= number_to_delimited(skipped_lines) %></dd>
    </dl>

    <h2>Responses <small>(what they get back)</small></h2>
    <dl class="right">
      <% if Stats.counters_by(:http_response).any? %>
        <% Stats.counters_by(:http_response).sort.each do |key, value| %>
          <dt><%= http_status_label(key) %></dt>
          <dd class="<%= http_status_level(key) %>"><%= number_to_delimited(value) %></dd>
        <% end %>
      <% else %>
        <dt>No request yet</dt>
        <dd>&ndash;</dd>
      <% end %>
    </dl>
  </article>

  <div class="flow__link">
    <span class="flow__arrow" aria-hidden="true"></span>
  </div>

  <article class="flow__node flow__node--wide">
    <h2>Buffer <small>(SQLite on disk)</small></h2>
    <p class="metric">
      <span class="metric__value"><%= number_to_delimited(incoming_total) %></span>
      <span class="metric__unit">values buffered</span>
    </p>

    <dl class="right">
      <dt>Time span <small>(max <%= max_range_hours %>h)</small></dt>
      <dd class="<%= status_of(:range) %>"><%= format_duration(incoming_range) %></dd>

      <dt>Retention</dt>
      <dd><%= retention_hours %>h</dd>

      <dt>Database size</dt>
      <dd><%= number_to_human_size(database_size) %></dd>

      <dt>Disk free</dt>
      <dd class="<%= status_of(:disk_free) %>"><%= number_to_human_size(disk_free) %></dd>
    </dl>

    <h2>House power <small>(recalculated from the buffer)</small></h2>
    <dl class="right">
      <div class="wide">
        <dt>Written to</dt>
        <dd class="font-mono"><%= value_or_dash(house_power_destination) { |d| h d } %></dd>
      </div>

      <dt>Values calculated</dt>
      <dd><%= number_to_delimited(calculation_count) %></dd>

      <dt>Calculation rate</dt>
      <dd><%= value_or_dash(calculation_rate) { |r| format_rate(r) } %></dd>

      <dt>Last calculation</dt>
      <dd class="<%= status_of(:last_success) %>"><%= value_or_dash(last_calculation_age) { |a| format_age(a) } %></dd>

      <dt>Skipped <small>(value missing)</small></dt>
      <dd class="<%= status_of(:skipped_stale) %>"><%= value_or_dash(calculation_skipped) { |v| number_to_percentage(v, precision: 1) } %></dd>
    </dl>

    <h2>Queue <small>(waiting for InfluxDB)</small></h2>
    <dl class="right">
      <dt>Lines waiting</dt>
      <dd class="<%= status_of(:queued) %>"><%= number_to_delimited(outgoing_total) %></dd>

      <dt>Oldest line</dt>
      <dd class="<%= status_of(:queue_age) %>"><%= format_duration(queue_oldest_age) %></dd>
    </dl>
  </article>

  <div class="flow__link">
    <span class="flow__arrow" aria-hidden="true"></span>
  </div>

  <article class="flow__node">
    <h2>Outgoing <small>(to InfluxDB)</small></h2>
    <p class="metric">
      <span class="metric__value"><%= value_or_dash(outgoing_delivered_values_rate) { |r| number_to_delimited(rate_number(r)) } %></span>
      <span class="metric__unit">values /min</span>
    </p>

    <dl class="right">
      <dt>Line throughput</dt>
      <dd><%= value_or_dash(outgoing_delivered_rate) { |r| format_rate(r) } %></dd>
    </dl>

    <h2>Since start</h2>
    <dl class="right">
      <dt>Values delivered</dt>
      <dd><%= number_to_delimited(outgoing_delivered_values) %></dd>

      <dt>Lines delivered</dt>
      <dd><%= number_to_delimited(outgoing_delivered) %></dd>

      <dt>Failed, will retry</dt>
      <dd class="<%= status_of(:failures) %>"><%= number_to_delimited(outgoing_failures) %></dd>

      <dt>Partly written <small>(lines affected)</small></dt>
      <dd class="<%= status_of(:partial) %>"><%= number_to_delimited(outgoing_partial) %></dd>

      <dt>Refused and lost</dt>
      <dd class="<%= status_of(:dropped) %>"><%= number_to_delimited(outgoing_dropped) %></dd>
    </dl>

    <!-- One block per target, not one row: a bucket and an org are names of
         the configuration, and they are as long as somebody makes them. Two
         of them on one row break in the middle of a word. -->
    <h2>Targets <small>(where the lines go)</small></h2>
    <% if targets.any? %>
      <% targets.each do |target| %>
        <dl class="right">
          <div class="wide">
            <dt>Bucket</dt>
            <dd class="font-mono"><%= h target[:bucket] %></dd>
          </div>

          <div class="wide">
            <dt>Org</dt>
            <dd class="font-mono"><%= h target[:org] %></dd>
          </div>

          <dt>Tokens</dt>
          <dd><%= number_to_delimited(target[:tokens]) %></dd>
        </dl>
      <% end %>
    <% else %>
      <dl class="right">
        <dt>Targets</dt>
        <dd>&ndash;</dd>
      </dl>
    <% end %>
  </article>
</section>

<div class="grid">
  <section>
    <h2>Sensor cache <small>(for the house power)</small></h2>
    <dl class="right">
      <dt>Sensors cached</dt>
      <dd><%= number_to_delimited(cache_size) %></dd>

      <dt>Cached time span</dt>
      <dd><%= format_duration(cache_range) %></dd>

      <dt>Cache hits <small>(of all calculations)</small></dt>
      <dd><%= value_or_dash(calculation_cache_hits) { |v| number_to_percentage(v, precision: 0) } %></dd>

      <dt>Interpolator queries <small>(after a miss)</small></dt>
      <dd><%= number_to_delimited(interpolate_queries) %></dd>

      <dt>Interpolator queries <small>(per request)</small></dt>
      <dd><%= value_or_dash(interpolate_queries_per_request) { |v| v.round(2) } %></dd>
    </dl>

    <% if calculation_skips_by_sensor.any? %>
      <h2>Missing values by sensor <small>(one skip can miss several)</small></h2>
      <dl class="right">
        <% calculation_skips_by_sensor.each do |sensor, count| %>
          <dt class="font-mono"><%= h sensor %></dt>
          <dd><%= number_to_delimited(count) %></dd>
        <% end %>
      </dl>
    <% end %>
  </section>

  <section>
    <h2>Runtime</h2>
    <dl class="right">
      <dt>CPU usage</dt>
      <dd><%= number_to_percentage(cpu_usage, precision: 1) %></dd>

      <dt>Memory usage</dt>
      <dd><%= number_to_human_size(memory_usage) %></dd>

      <dt>Threads</dt>
      <dd><%= thread_count %></dd>
    </dl>
  </section>

  <section>
    <h2>Uptime</h2>
    <dl class="right">
      <dt>Ingest</dt>
      <dd><%= format_duration(container_uptime) %></dd>

      <dt>Host</dt>
      <dd><%= format_duration(system_uptime) %></dd>
    </dl>
  </section>
</div>

<section class="section">
  <h2 class="section__label">
    Configured sensors
    <small>
      <% if configured_sensors.empty? %>
        (no INFLUX_SENSOR_* variable is set)
      <% elsif included_sensors.empty? %>
        (the house power excludes every one of them)
      <% elsif sensors_summary %>
        (<span class="<%= sensors_summary_level %>"><%= sensors_summary %></span>)
      <% else %>
        (all <%= included_sensors.size %> receive data)
      <% end %>
    </small>
  </h2>

  <% if configured_sensors.any? %>
    <div class="cards cards--wide">
      <!-- Two cards: what the house power needs, and what it leaves out. One
           list would carry both, and a reader would then read a missing value
           as the same fault in each case. Only the first card can hold the
           house power back. -->
      <% if included_sensors.any? %>
        <article class="card">
          <h3 class="card__title">The house power</h3>
          <%= erb :_sensors, layout: false, locals: { sensors: included_sensors } %>
        </article>
      <% end %>

      <% if excluded_sensors.any? %>
        <article class="card">
          <h3 class="card__title">
            Excluded from the house power
            <small>(INFLUX_EXCLUDE_FROM_HOUSE_POWER)</small>
          </h3>
          <%= erb :_sensors, layout: false, locals: { sensors: excluded_sensors } %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>

<section class="section">
  <h2 class="section__label">
    Other incoming data
    <small>
      <% if other_measurement_fields_grouped.any? %>
        (forwarded, not a configured sensor)
      <% else %>
        (nothing arrives besides the sensors above)
      <% end %>
    </small>
  </h2>

  <div class="cards">
    <% other_measurement_fields_grouped.each do |measurement, groups| %>
      <article class="card">
        <h3 class="card__title"><%= h measurement %></h3>
        <ul class="card__list">
          <% groups.each do |group| %>
            <li>
              <span class="font-mono"><%= h group[:field] %></span>
              <%= stream_tag(group) %>
            </li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>
</section>
